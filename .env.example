# [!!!] Don't use the .env file, but use the inline environment variables (Taskfile / Docker / manually)

ENV=local|dev|prod|test

SERVICE_NAME=shortlink-analytics-sender-cron-job
SERVICE_VERSION=0.0.0

CRON_SCHEDULE=0 20 * * *
CRON_ZONE=Europe/Moscow

ANALYTICS_API_HOST=localhost
ANALYTICS_API_PORT=50051
ANALYTICS_API_KEEP_ALIVE_TIME=10s
ANALYTICS_API_CONNECT_TIMEOUT=10s

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=shortlink-analytics-sender@localhost.ru
